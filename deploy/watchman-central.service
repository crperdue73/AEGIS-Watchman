# watchman central — systemd unit (template)
#
# Install:
#
#   sudo install -m 0755 bin/watchman-central /usr/local/bin/
#   sudo install -d -m 0750 -o watchman -g watchman /etc/watchman /var/lib/watchman
#   sudo cp deploy/watchman-central.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now watchman-central
#
# Central reads its config, TLS material, uid_map, and approval manifests from
# /etc/watchman (read-only) and writes its durable baseline + record stores to
# /var/lib/watchman. It needs NO root and no capabilities. See deploy/README.md.

[Unit]
Description=watchman central (ingest, alerting, fleet view)
Documentation=https://github.com/crperdue73/AEGIS-Watchman
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=watchman
Group=watchman
ExecStart=/usr/local/bin/watchman-central -config /etc/watchman/central.yaml
Restart=on-failure
RestartSec=5s

# Durable stores (baselines, records) live here; the rest of the filesystem is
# read-only. Central does not need the agent workspaces, so /home is hidden
# entirely (stronger than the collector's read-only).
StateDirectory=watchman
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Ingest (TCP) plus, if you use an email sink, SMTP (TCP) — all AF_INET/INET6.
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
