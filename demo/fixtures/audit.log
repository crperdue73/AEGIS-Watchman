# Captured auditd stream — the CARBONATO canonical chain.
#
# This is what auditd emits (with the rules in docs/deploy-collector.md) when an
# agent turns on its own operator: it reads a secret, spawns a shell, and reaches
# out to a chat/C2 endpoint. The collector replays this file from the start, so
# the rules fire with no root, no live auditd, and no daemon.
#
# Frame 1 (audit 1790593000.100:800): execve of a shell that cats an SSH key.
#   -> process.exec; fires carbonato.exec.shell_spawn, and the secret-read order
#      rule (AI/SSH key access precedes credential-looking work).
type=SYSCALL msg=audit(1790593000.100:800): arch=x86_64 syscall=execve success=yes pid=4242 ppid=1 uid=1000 auid=1000 exe="/usr/bin/bash"
type=EXECVE msg=audit(1790593000.100:800): argc=3 a0="bash" a1="-c" a2="cat ~/.ssh/id_ed25519"

# Frame 2 (audit 1790593000.200:801): the fd-2 connect to Slack :443.
#   saddr 020001bb037881e2 = AF_INET (0002), port 443 (01bb), 3.120.129.226.
#   -> net.egress; fires the C2/chat egress rule (carbonato.exfil.egress_after_change).
#      In a later pass, once an identity file has drifted, the same egress also
#      feeds the egress-after-identity-change correlation — the rule this whole
#      project exists for.
type=SYSCALL msg=audit(1790593000.200:801): arch=x86_64 syscall=connect success=yes pid=4242 ppid=1 uid=1000 auid=1000 exe="/usr/bin/curl"
type=SOCKADDR msg=audit(1790593000.200:801): saddr=020001bb037881e2

# Frame 3 (audit 1790593000.300:802): the foothold — the intruder opens a
# listener to keep the door open.
#   -> net.listen; fires carbonato.net.listener_bound.
type=SYSCALL msg=audit(1790593000.300:802): arch=x86_64 syscall=bind success=yes pid=4242 ppid=1 uid=1000 auid=1000 exe="/usr/bin/nc"
type=SOCKADDR msg=audit(1790593000.300:802): saddr=0200115c00000000
type=SYSCALL msg=audit(1790593000.300:803): arch=x86_64 syscall=listen success=yes pid=4242 ppid=1 uid=1000 auid=1000 exe="/usr/bin/nc"

# Frame 4 (audit 1790593000.400:804): a wrapped interpreter drops a cron entry.
#   The file is created by a python script, so no command line ever names the
#   path — the argv rule (carbonato.persist.cron_or_rc) cannot see this write.
#   The kernel can: this is an auditd file watch (-w /etc/cron.d -p wa), and its
#   CREATE PATH names the file.
#   -> file.write; fires carbonato.persist.file_write (G3's write half).
type=SYSCALL msg=audit(1790593000.400:804): arch=x86_64 syscall=openat success=yes pid=4242 ppid=1 uid=1000 auid=1000 exe="/usr/bin/python3" key="agentids"
type=CWD msg=audit(1790593000.400:804): cwd="/home/agent"
type=PATH msg=audit(1790593000.400:804): item=0 name="/etc/cron.d" inode=900 nametype=PARENT
type=PATH msg=audit(1790593000.400:804): item=1 name="/etc/cron.d/agentids-beacon" inode=901 nametype=CREATE
